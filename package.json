    "audit:package": "node scripts/audit-package.mjs",
    "test:live": "npm run build && node scripts/test-live.mjs"
  },
  "devDependencies": {
    "electron": "41.10.7",
    "electron-builder": "26.18.0",
    "fast-xml-parser": "5.11.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "rolldown": "1.2.15",
    "tar": "7.5.22",
    "yaml": "2.9.1",
    "zod": "4.6.7"
  }
