{
  "name": "dsh-wechat-app",
  "productName": "Wechat Agent App",
  "version": "0.1.7-preview.8",
  "description": "独立运行的微信助手：自然聊天、持久记忆、朋友圈与自动化",
  "author": "Wechat Agent contributors",
  "private": true,
  "type": "module",
  "main": "desktop/main.cjs",
  "license": "AGPL-3.0-or-later",
  "engines": {
    "node": ">=22.18"
  },
  "os": [
    "win32"
  ],
  "cpu": [
    "x64"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
